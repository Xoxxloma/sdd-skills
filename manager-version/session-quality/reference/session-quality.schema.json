{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "session-quality/6",
  "title": "Оценка качества работы пользователя в одной сессии",
  "description": "Одна сессия — один файл <id>.quality.json рядом с её выгрузкой. Числа ставит скрипт merge; модель только находит смысловое с цитатой. Скора в выходе нет: за период его считает дашборд по суммам hits и events метрик всех сессий пользователя и по good / bad / weight. Правила, которые схемой не выразить (доля = hits / events, минимум событий, end_break), проверяет contract.py.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "generated_at", "params", "session", "fraud", "environment"],
  "properties": {
    "schema": {"const": "session-quality/6"},
    "generated_at": {"type": "string", "format": "date-time"},
    "params": {"$ref": "#/$defs/params"},
    "session": {"$ref": "#/$defs/session"},
    "metrics": {
      "description": "Только у оценённой сессии: все метрики, которые считает код (params.IMPLEMENTED_METRICS), каждая ровно один раз.",
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/metric"}
    },
    "fraud": {"$ref": "#/$defs/fraud"},
    "discipline": {"$ref": "#/$defs/discipline"},
    "environment": {"$ref": "#/$defs/environment"}
  },
  "allOf": [
    {"if": {"properties": {"session": {"properties": {"scored": {"const": true}}}}},
     "then": {"required": ["metrics", "discipline"]},
     "else": {"allOf": [{"not": {"required": ["metrics"]}}, {"not": {"required": ["discipline"]}}]}}
  ],
  "$defs": {
    "count": {"type": "integer", "minimum": 0},
    "timestamp": {"type": "string", "format": "date-time"},
    "turn": {"description": "Номер записи в журнале сессии.", "type": "integer", "minimum": 1},
    "quote": {"description": "Цитата из журнала, не длиннее строки; секреты и цифры замаскированы.", "type": "string", "minLength": 1, "maxLength": 200},

    "params": {
      "description": "Параметры, с которыми посчитана сессия (из params.json или --params), — те, что нужны дашборду для периода.",
      "type": "object",
      "additionalProperties": false,
      "required": ["min_events", "min_measured_weight", "continuation_hours"],
      "properties": {
        "min_events": {"description": "Метрика считается от стольких событий за период.", "type": "number", "minimum": 0},
        "min_measured_weight": {"description": "Скор за период ставится, если измерено не меньше этого % веса метрик.", "type": "number", "minimum": 0, "maximum": 100},
        "continuation_hours": {"description": "Окно продолжения: следующая сессия началась в пределах — обрыв end_break снимается.", "type": "number", "minimum": 0}
      }
    },

    "session": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "user", "start", "end", "duration_sec", "user_turns", "skills", "context_peak", "scored"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "user": {"description": "Логин из выгрузки; нет или несколько — --user, иначе имя папки сессий.", "type": "string", "minLength": 1},
        "start": {"$ref": "#/$defs/timestamp"},
        "end": {"$ref": "#/$defs/timestamp"},
        "duration_sec": {"$ref": "#/$defs/count"},
        "user_turns": {"$ref": "#/$defs/count"},
        "skills": {"description": "Скиллы по порядку вызова.", "type": "array", "items": {"type": "string", "minLength": 1}},
        "context_peak": {"description": "Наибольшая доля окна модели; null — нет поля в журнале.", "type": ["number", "null"], "minimum": 0, "maximum": 1},
        "scored": {"description": "false — сессия короче params min_user_turns реплик: метрик и посторонних тем нет, фрод и окружение есть.", "type": "boolean"},
        "skip_reason": {"type": "string", "minLength": 1}
      },
      "allOf": [
        {"if": {"properties": {"scored": {"const": false}}}, "then": {"required": ["skip_reason"]}},
        {"if": {"properties": {"scored": {"const": true}}}, "then": {"not": {"required": ["skip_reason"]}}}
      ]
    },

    "metric": {
      "description": "value = hits / events с округлением до трёх знаков; events — знаменатель доли, hits — числитель (у метрик «чем больше, тем лучше» — хорошие события, у остальных — плохие). Меньше params.min_events событий — метрика не измерена. Скор метрики = clamp((value − bad) / (good − bad), 0, 1) × 100 — его считает дашборд по суммам за период.",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "status", "value", "hits", "events", "good", "bad", "weight", "source", "evidence"],
      "properties": {
        "id": {"enum": ["active_review", "blind_confirms", "delegated", "ignored", "completion", "loaded_context", "skill_share"]},
        "status": {"enum": ["measured", "not_measured"]},
        "reason": {"type": "string", "minLength": 1},
        "value": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "hits": {"$ref": "#/$defs/count"},
        "events": {"$ref": "#/$defs/count"},
        "good": {"type": "number"},
        "bad": {"type": "number"},
        "weight": {"type": "number", "exclusiveMinimum": 0},
        "source": {"enum": ["script", "model", "script+model"]},
        "end_break": {"description": "Только у completion: последний запуск брошен в конце сессии. Следующая сессия пользователя началась в пределах params.continuation_hours после session.end — это продолжение: дашборд прибавляет его к hits.", "type": "boolean"},
        "evidence": {"type": "array", "items": {"$ref": "#/$defs/quote_evidence"}}
      },
      "allOf": [
        {"if": {"properties": {"status": {"const": "measured"}}}, "then": {"properties": {"value": {"type": "number"}}}},
        {"if": {"properties": {"status": {"const": "not_measured"}}}, "then": {"required": ["reason"], "properties": {"value": {"type": "null"}}}},
        {"if": {"properties": {"id": {"const": "completion"}}}, "then": {"required": ["end_break"]}, "else": {"not": {"required": ["end_break"]}}}
      ]
    },

    "quote_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["turn", "quote"],
      "properties": {
        "turn": {"$ref": "#/$defs/turn"},
        "quote": {"$ref": "#/$defs/quote"},
        "note": {"type": "string", "minLength": 1}
      }
    },
    "topic_evidence": {
      "description": "Посторонняя тема: личное не цитируется — только где и сколько.",
      "type": "object",
      "additionalProperties": false,
      "required": ["turn", "category", "turns"],
      "properties": {
        "turn": {"$ref": "#/$defs/turn"},
        "category": {"enum": ["personal", "non_work"]},
        "turns": {"type": "integer", "minimum": 1}
      }
    },

    "fraud": {
      "description": "В скор не входит; to_review — скор за период «не окончательный».",
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "signals"],
      "properties": {
        "status": {"enum": ["none", "to_review"]},
        "signals": {"type": "array", "items": {"$ref": "#/$defs/fraud_signal"}}
      },
      "allOf": [
        {"if": {"properties": {"status": {"const": "none"}}}, "then": {"properties": {"signals": {"maxItems": 0}}}},
        {"if": {"properties": {"status": {"const": "to_review"}}}, "then": {"properties": {"signals": {"minItems": 1}}}}
      ]
    },
    "fraud_signal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "status", "count", "evidence"],
      "properties": {
        "kind": {"enum": ["deception", "bypass", "autoinput"]},
        "status": {"const": "to_review"},
        "count": {"type": "integer", "minimum": 1},
        "evidence": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/quote_evidence"}}
      }
    },

    "discipline": {
      "description": "Вне скора: посторонние темы — сколько и где, без пересказа.",
      "type": "object",
      "additionalProperties": false,
      "required": ["off_topic"],
      "properties": {
        "off_topic": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "cases", "replies", "evidence"],
          "properties": {
            "status": {"enum": ["measured", "not_measured"]},
            "reason": {"type": "string", "minLength": 1},
            "cases": {"$ref": "#/$defs/count"},
            "replies": {"$ref": "#/$defs/count"},
            "evidence": {"type": "array", "items": {"$ref": "#/$defs/topic_evidence"}}
          },
          "allOf": [
            {"if": {"properties": {"status": {"const": "not_measured"}}}, "then": {"required": ["reason"]}}
          ]
        }
      }
    },

    "environment": {
      "description": "Чужие сбои — справочно, в скор не входят.",
      "type": "object",
      "additionalProperties": false,
      "required": ["tool_errors", "api_errors", "compressions"],
      "properties": {
        "tool_errors": {"$ref": "#/$defs/env_value"},
        "api_errors": {"$ref": "#/$defs/env_value"},
        "compressions": {"$ref": "#/$defs/env_value"}
      }
    },
    "env_value": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "value"],
      "properties": {
        "status": {"enum": ["measured", "not_measured"]},
        "value": {"type": ["integer", "null"], "minimum": 0},
        "reason": {"type": "string", "minLength": 1}
      },
      "allOf": [
        {"if": {"properties": {"status": {"const": "measured"}}}, "then": {"properties": {"value": {"type": "integer"}}}},
        {"if": {"properties": {"status": {"const": "not_measured"}}}, "then": {"required": ["reason"], "properties": {"value": {"type": "null"}}}}
      ]
    }
  }
}
