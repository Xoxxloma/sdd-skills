{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "session-quality/4",
  "title": "Оценка качества работы пользователя по его сессиям",
  "description": "Один документ — один пользователь за период. Числа, скоры и статусы ставит скрипт merge; модель только находит смысловое с цитатой. Правила, которые схемой не выразить (формула скора, статус, минимум событий, ссылки на сессии), проверяет contract.py.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "generated_at", "subject", "params", "score", "metrics", "fraud", "discipline", "environment", "sessions"],
  "properties": {
    "schema": {"const": "session-quality/4"},
    "generated_at": {"type": "string", "format": "date-time"},
    "subject": {"$ref": "#/$defs/subject"},
    "params": {"$ref": "#/$defs/params"},
    "score": {"$ref": "#/$defs/score"},
    "metrics": {
      "description": "Все метрики, которые считает код (params.IMPLEMENTED_METRICS), каждая ровно один раз.",
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/metric"}
    },
    "fraud": {"$ref": "#/$defs/fraud"},
    "discipline": {"$ref": "#/$defs/discipline"},
    "environment": {"$ref": "#/$defs/environment"},
    "sessions": {
      "description": "Все сессии из папки, и оценённые, и пропущенные.",
      "type": "array",
      "items": {"$ref": "#/$defs/session"}
    }
  },
  "$defs": {
    "session_id": {"type": "string", "minLength": 1},
    "count": {"type": "integer", "minimum": 0},
    "timestamp": {"type": "string", "format": "date-time"},
    "turn": {"description": "Номер записи в журнале сессии.", "type": "integer", "minimum": 1},
    "quote": {"description": "Цитата из журнала, не длиннее строки; секреты и цифры замаскированы.", "type": "string", "minLength": 1, "maxLength": 200},

    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["user", "sessions_dir", "period", "sessions_total", "sessions_scored"],
      "properties": {
        "user": {"type": "string", "minLength": 1},
        "sessions_dir": {"type": "string", "minLength": 1},
        "period": {
          "description": "От самого раннего начала до самого позднего конца по всем сессиям; null — сессий нет.",
          "oneOf": [
            {"type": "null"},
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["from", "to"],
              "properties": {"from": {"$ref": "#/$defs/timestamp"}, "to": {"$ref": "#/$defs/timestamp"}}
            }
          ]
        },
        "sessions_total": {"$ref": "#/$defs/count"},
        "sessions_scored": {"$ref": "#/$defs/count"}
      }
    },

    "params": {
      "description": "Параметры, с которыми посчитан документ (из params.json или --params).",
      "type": "object",
      "additionalProperties": false,
      "required": ["file", "min_events", "min_measured_weight"],
      "properties": {
        "file": {"type": "string", "minLength": 1},
        "min_events": {"type": "number", "minimum": 0},
        "min_measured_weight": {"type": "number", "minimum": 0, "maximum": 100}
      }
    },

    "score": {
      "description": "value = округление (Σ weight × score) / Σ weight по измеренным метрикам. insufficient — измерено меньше params.min_measured_weight % веса; иначе hold — у фрода есть сигнал к проверке; иначе final.",
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "status", "reason", "measured_weight"],
      "properties": {
        "value": {"type": ["integer", "null"], "minimum": 0, "maximum": 100},
        "status": {"enum": ["final", "hold", "insufficient"]},
        "reason": {"type": ["string", "null"], "minLength": 1},
        "measured_weight": {"description": "Доля веса измеренных метрик, в процентах.", "type": "number", "minimum": 0, "maximum": 100}
      },
      "allOf": [
        {"if": {"properties": {"status": {"const": "final"}}}, "then": {"properties": {"value": {"type": "integer"}, "reason": {"type": "null"}}}},
        {"if": {"properties": {"status": {"const": "hold"}}}, "then": {"properties": {"value": {"type": "integer"}, "reason": {"type": "string"}}}},
        {"if": {"properties": {"status": {"const": "insufficient"}}}, "then": {"properties": {"value": {"type": "null"}, "reason": {"type": "string"}}}}
      ]
    },

    "metric": {
      "description": "score = округление clamp((value − bad) / (good − bad), 0, 1) × 100. events — сколько событий в знаменателе; меньше params.min_events — метрика не измерена. sessions_hit — оценённые сессии, где метрика хуже good.",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "status", "value", "score", "good", "bad", "weight", "source", "events", "sessions_hit", "evidence"],
      "properties": {
        "id": {"enum": ["active_review", "blind_confirms", "delegated", "ignored", "completion", "task_setup", "loaded_context", "skill_share"]},
        "status": {"enum": ["measured", "not_measured"]},
        "reason": {"type": "string", "minLength": 1},
        "value": {"type": ["number", "null"], "minimum": 0},
        "score": {"type": ["integer", "null"], "minimum": 0, "maximum": 100},
        "good": {"type": "number"},
        "bad": {"type": "number"},
        "weight": {"type": "number", "exclusiveMinimum": 0},
        "source": {"enum": ["script", "model", "script+model"]},
        "events": {"$ref": "#/$defs/count"},
        "sessions_hit": {"$ref": "#/$defs/count"},
        "evidence": {"type": "array", "items": {"$ref": "#/$defs/quote_evidence"}}
      },
      "allOf": [
        {"if": {"properties": {"status": {"const": "measured"}}}, "then": {"properties": {"value": {"type": "number"}, "score": {"type": "integer"}}}},
        {"if": {"properties": {"status": {"const": "not_measured"}}}, "then": {"required": ["reason"], "properties": {"value": {"type": "null"}, "score": {"type": "null"}}}}
      ]
    },

    "quote_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["session", "turn", "quote"],
      "properties": {
        "session": {"$ref": "#/$defs/session_id"},
        "turn": {"$ref": "#/$defs/turn"},
        "quote": {"$ref": "#/$defs/quote"},
        "note": {"type": "string", "minLength": 1}
      }
    },
    "topic_evidence": {
      "description": "Посторонняя тема: личное не цитируется — только где и сколько.",
      "type": "object",
      "additionalProperties": false,
      "required": ["session", "turn", "category", "turns"],
      "properties": {
        "session": {"$ref": "#/$defs/session_id"},
        "turn": {"$ref": "#/$defs/turn"},
        "category": {"enum": ["personal", "non_work"]},
        "turns": {"type": "integer", "minimum": 1}
      }
    },

    "fraud": {
      "description": "В скор не входит; to_review переводит скор в hold.",
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "signals"],
      "properties": {
        "status": {"enum": ["none", "to_review"]},
        "signals": {"type": "array", "items": {"$ref": "#/$defs/fraud_signal"}}
      },
      "allOf": [
        {"if": {"properties": {"status": {"const": "none"}}}, "then": {"properties": {"signals": {"maxItems": 0}}}},
        {"if": {"properties": {"status": {"const": "to_review"}}}, "then": {"properties": {"signals": {"minItems": 1}}}}
      ]
    },
    "fraud_signal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "status", "count", "sessions", "evidence"],
      "properties": {
        "kind": {"enum": ["deception", "bypass", "autoinput"]},
        "status": {"const": "to_review"},
        "count": {"type": "integer", "minimum": 1},
        "sessions": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/session_id"}},
        "evidence": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/quote_evidence"}}
      }
    },

    "discipline": {
      "description": "Вне скора: посторонние темы — сколько и где, без пересказа.",
      "type": "object",
      "additionalProperties": false,
      "required": ["off_topic"],
      "properties": {
        "off_topic": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "cases", "replies", "sessions", "evidence"],
          "properties": {
            "status": {"enum": ["measured", "not_measured"]},
            "reason": {"type": "string", "minLength": 1},
            "cases": {"$ref": "#/$defs/count"},
            "replies": {"$ref": "#/$defs/count"},
            "sessions": {"type": "array", "items": {"$ref": "#/$defs/session_id"}},
            "evidence": {"type": "array", "items": {"$ref": "#/$defs/topic_evidence"}}
          },
          "allOf": [
            {"if": {"properties": {"status": {"const": "not_measured"}}}, "then": {"required": ["reason"]}}
          ]
        }
      }
    },

    "environment": {
      "description": "Чужие сбои — справочно, в скор не входят.",
      "type": "object",
      "additionalProperties": false,
      "required": ["tool_errors", "api_errors", "compressions"],
      "properties": {
        "tool_errors": {"$ref": "#/$defs/env_value"},
        "api_errors": {"$ref": "#/$defs/env_value"},
        "compressions": {"$ref": "#/$defs/env_value"}
      }
    },
    "env_value": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "value"],
      "properties": {
        "status": {"enum": ["measured", "not_measured"]},
        "value": {"type": ["integer", "null"], "minimum": 0},
        "reason": {"type": "string", "minLength": 1}
      },
      "allOf": [
        {"if": {"properties": {"status": {"const": "measured"}}}, "then": {"properties": {"value": {"type": "integer"}}}},
        {"if": {"properties": {"status": {"const": "not_measured"}}}, "then": {"required": ["reason"], "properties": {"value": {"type": "null"}}}}
      ]
    },

    "session": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "start", "end", "duration_sec", "user_turns", "skills", "context_peak", "scored"],
      "properties": {
        "id": {"$ref": "#/$defs/session_id"},
        "start": {"$ref": "#/$defs/timestamp"},
        "end": {"$ref": "#/$defs/timestamp"},
        "duration_sec": {"$ref": "#/$defs/count"},
        "user_turns": {"$ref": "#/$defs/count"},
        "skills": {"description": "Скиллы по порядку вызова.", "type": "array", "items": {"type": "string", "minLength": 1}},
        "context_peak": {"description": "Наибольшая доля окна модели; null — нет поля в журнале.", "type": ["number", "null"], "minimum": 0, "maximum": 1},
        "scored": {"type": "boolean"},
        "skip_reason": {"type": "string", "minLength": 1}
      },
      "allOf": [
        {"if": {"properties": {"scored": {"const": false}}}, "then": {"required": ["skip_reason"]}},
        {"if": {"properties": {"scored": {"const": true}}}, "then": {"not": {"required": ["skip_reason"]}}}
      ]
    }
  }
}
