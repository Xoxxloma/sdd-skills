    "POST /api/v2/shipments/:id/retry",
    "GET /api/v2/shipments/:id/history",
    "POST /api/v2/shipments/:id/attachments",
    "GET /api/v2/shipments/:id/label",
    "GET /api/v2/tariffs",
    "POST /api/v2/shipments/bulk",
    "GET /api/v2/carriers",
    "POST /api/v2/carriers",
    "PATCH /api/v2/carriers/:id/state",
    "DELETE /api/v2/carriers/:id",
    "GET /health",
    "GET /ready",
    "query shipment",
    "query shipmentHistory",
    "mutation holdShipment",
    "mutation releaseShipment",
    "Shipment",
    "Carrier",
