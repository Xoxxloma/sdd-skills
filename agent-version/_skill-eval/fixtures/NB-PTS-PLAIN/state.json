{
  "notebook": "notes/прокат-лыж/notebook.md",
  "stages": [
    {
      "mode": "write",
      "writeFirst": true,
      "maxNew": 3,
      "onlyListed": true,
      "answer1MustNot": [
        "записать так|записываю\\?|пишу\\?|поправить\\?"
      ],
      "new": [
        {
          "as": "A",
          "kind": "решено",
          "has": [
            "шкафчик",
            "у входа"
          ],
          "decider": "фомич"
        },
        {
          "as": "B",
          "kind": "сведение",
          "has": [
            "на полу"
          ]
        },
        {
          "as": "C",
          "kind": "открыто",
          "has": [
            "сколько шкафчиков"
          ],
          "waits": "брагин"
        }
      ]
    }
  ],
  "mutations": [
    {
      "name": "вопрос «Записать так?» перед записью",
      "stage": 1,
      "target": "answer-01.md",
      "edits": [
        [
          "Совпадений с прошлыми записями нет.",
          "Записать так или поправить?"
        ]
      ]
    },
    {
      "name": "запись не на ходу 1",
      "stage": 1,
      "target": "stream.jsonl",
      "edits": [
        [
          "\"name\":\"Edit\"",
          "\"name\":\"Read\""
        ]
      ]
    }
  ]
}
