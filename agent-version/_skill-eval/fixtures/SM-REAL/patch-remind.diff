+  async remind(companyId: string, projectId: string, id: string, userId: string, userName: string, role: string) {
+    if (role === UserRole.CUSTOMER) throw new ForbiddenException()
+    await this.verifyAccess(companyId, projectId, userId, role)
+
+    const acceptance = await this.prisma.workAcceptance.findFirst({
+      where: { id, projectId },
+      select: { id: true, number: true, status: true, lastRemindedAt: true },
+    })
+    if (!acceptance) throw new NotFoundException('Заявка не найдена')
+    if (acceptance.status !== 'PENDING') {
+      throw new BadRequestException('Напомнить можно только о нерассмотренном акте')
+    }
+    if (acceptance.lastRemindedAt && Date.now() - acceptance.lastRemindedAt.getTime() < REMIND_INTERVAL_MS) {
+      throw new ConflictException('Напоминание по этому акту уже отправлялось за последние сутки')
+    }
+
+    await this.prisma.workAcceptance.update({ where: { id }, data: { lastRemindedAt: new Date() } })
+
+    void this.notifications
+      .notifyProjectParticipants(projectId, 'ACCEPTANCE_REMINDER', userName, userId, `Акт №${acceptance.number}`)
       .catch((err: unknown) => this.logger.warn({ err }, 'notification dispatch failed'))
   }
 
