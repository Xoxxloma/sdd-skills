--- a/repairy-api/src/common/pipes/kaskad-format.pipe.ts	1970-01-01 03:00:00.000000000 +0300
+++ b/repairy-api/src/common/pipes/kaskad-format.pipe.ts	2026-09-21 21:12:31.472582000 +0300
@@ -0,0 +1,17 @@
+import { BadRequestException, PipeTransform } from '@nestjs/common'
+
+// Смета принимается только в формате выгрузки АС Каскад: первая строка — фиксированный заголовок.
+// Это проверка формата входа, а не режим сервиса: включить или выключить её никто не может.
+const KASKAD_HEADER = 'Смета;Раздел;Работа;Ед.;Кол-во;Цена'
+
+export class KaskadFormatPipe implements PipeTransform<string, string> {
+  transform(value: string): string {
+    const firstLine = value.split(/\r?\n/, 1)[0]?.trim() ?? ''
+    if (firstLine !== KASKAD_HEADER) {
+      throw new BadRequestException(
+        `Файл не является выгрузкой АС Каскад: ожидается заголовок «${KASKAD_HEADER}»`,
+      )
+    }
+    return value
+  }
+}
